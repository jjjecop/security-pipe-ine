# Copy this file to .env and fill in the values:
#   Copy-Item .env.example .env

# Database (used by docker-compose.yml and db.py)
POSTGRES_USER=secpipeline
POSTGRES_PASSWORD=
POSTGRES_DB=secpipeline

# Gemini API key for remediation text (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

API_KEY=

# Redis for the scan queue (docker-compose.yml)
REDIS_URL=redis://localhost:6379/0

# Optional
# GEMINI_MODEL=gemini-3.6-flash
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Only needed if an antivirus intercepts HTTPS (e.g. Norton) - see README
# REQUESTS_CA_BUNDLE=C:\path\to\ca-bundle.pem
# SSL_CERT_FILE=C:\path\to\ca-bundle.pem
# What POST /scans may scan. Anything not listed is refused.
# Repo folders separated by ; and hosts separated by ,
SCAN_ALLOWED_REPO_ROOTS=C:\Allprojects\Targets
SCAN_ALLOWED_HOSTS=host.docker.internal,localhost
