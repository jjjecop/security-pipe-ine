# Copy this file to .env and fill in the values:
#   Copy-Item .env.example .env

# Database (used by docker-compose.yml and db.py)
POSTGRES_USER=secpipeline
POSTGRES_PASSWORD=
POSTGRES_DB=secpipeline

# Gemini API key for remediation text (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-3.6-flash
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Only needed if an antivirus intercepts HTTPS (e.g. Norton) - see README
# REQUESTS_CA_BUNDLE=C:\path\to\ca-bundle.pem
# SSL_CERT_FILE=C:\path\to\ca-bundle.pem